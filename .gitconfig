[user]
	name = Francois Ward
	email = fward@hey.com
[init]
	defaultBranch = main
[core]
	editor = vim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[push]
	autoSetupRemote = true
	default = current
[merge]
	conflictStyle = zdiff3
[delta]
	navigate = true
[alias]
	append = town append
	compress = town compress
	contribute = town contribute
	diff-parent = town diff-parent
	hack = town hack
	delete = town delete
	observe = town observe
	park = town park
	prepend = town prepend
	propose = town propose
	rename = town rename
	repo = town repo
	set-parent = town set-parent
	ship = town ship
	sync = town sync
